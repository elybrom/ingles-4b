@font-face{font-family:'Caveat';src:url(caveat.woff2) format('woff2');font-weight:400 700;font-display:swap}
*{box-sizing:border-box}
html,body{margin:0;background:#3a3f4b;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#222}
header{position:sticky;top:0;z-index:20;display:flex;gap:6px;align-items:center;padding:6px 8px;background:#1d3b8f;color:#fff;padding-top:max(6px,env(safe-area-inset-top))}
.tb{background:rgba(255,255,255,.14);color:#fff;border:0;border-radius:10px;padding:8px 10px;font-size:15px}
.pill{margin-left:auto;font-weight:600}
#pnum{font-size:14px;white-space:nowrap}
#stage{padding:8px 4px 78px;display:flex;justify-content:center}
.page{position:relative;width:100%;max-width:900px;background:#fff;box-shadow:0 2px 14px rgba(0,0,0,.4);container-type:inline-size;touch-action:pan-y pinch-zoom}
.page img{display:block;width:100%;height:auto;user-select:none;-webkit-user-drag:none}
#ov{position:absolute;inset:0}
.hs{position:absolute;border-radius:4px;cursor:pointer}
.hs:active,.hs.say{background:rgba(255,213,0,.35)}
.ans{position:absolute;display:flex;align-items:flex-end;font-family:'Caveat','Segoe Print','Comic Sans MS',cursive;color:#1546c9;font-weight:600;font-size:2.6cqw;line-height:1;white-space:nowrap;overflow:visible;cursor:pointer;z-index:3;padding:0 .2em}
.ans.voc{align-items:center;background:rgba(255,255,255,.6)}
.ans.say{background:rgba(255,230,80,.45)}
.ans .ej{font-family:system-ui;font-size:.55em;color:#7a8bb8;margin-right:.3em;font-weight:500}
.ans .unc,.unc{color:#c45a00;font-family:system-ui;font-weight:700;font-size:.7em;margin-left:.15em}
.ans.u{color:#7d5bbf}
.inp{position:absolute;z-index:4;display:flex;align-items:flex-end}
.inp input{width:100%;height:100%;border:0;border-bottom:2px dashed #7aa0ff;background:rgba(235,242,255,.75);font-family:'Caveat',cursive;font-size:2.6cqw;color:#1546c9;padding:0 .2em;outline:none;border-radius:3px 3px 0 0;min-width:0}
.inp.voc input{border:1px dashed #7aa0ff}
.inp input:focus{background:#fffbe0}
.inp.ok input{background:rgba(160,235,170,.75);border-bottom-color:#1a9a3a}
.inp.bad input{background:rgba(255,180,180,.75);border-bottom-color:#d22}
.inp .sol{position:absolute;left:0;top:100%;z-index:6;background:#fff;border:1px solid #d22;color:#b00;font-family:'Caveat',cursive;font-size:2.2cqw;padding:2px 6px;border-radius:6px;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.25)}
.inp .hint{position:absolute;right:-.2em;bottom:0;transform:translateX(100%);border:0;background:#ffe58a;border-radius:50%;width:1.6em;height:1.6em;font-size:1.6cqw;padding:0}
#tools{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;gap:6px;justify-content:space-between;align-items:center;padding:8px;padding-bottom:max(8px,env(safe-area-inset-bottom));background:rgba(20,24,34,.92)}
.nav{flex:0 0 auto;background:#fff;border:0;border-radius:12px;padding:12px 14px;font-size:16px;font-weight:600}
.tool{background:#ffcf33;border:0;border-radius:12px;padding:11px 12px;font-size:15px;font-weight:700}
.tool.on{background:#ff8a3d}
.danger{background:#ffb3b3}
#tools .tool{flex:1}
aside{position:fixed;inset:0 0 0 auto;width:min(380px,92vw);z-index:40;background:#fff;overflow:auto;padding:12px;box-shadow:-4px 0 18px rgba(0,0,0,.4)}
.dhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:17px}
.x{border:0;background:#eee;border-radius:8px;font-size:18px;padding:4px 10px}
#lesList button{display:flex;width:100%;text-align:left;gap:10px;align-items:center;border:0;border-bottom:1px solid #eee;background:#fff;padding:11px 6px;font-size:15px}
#lesList button b{display:inline-block;min-width:44px;background:#1d3b8f;color:#fff;border-radius:8px;text-align:center;padding:6px 0}
#lesList button.cur{background:#eef3ff}
#lesList small{color:#666}
.goto{margin-top:12px;display:flex;gap:6px;align-items:center;font-size:14px}
.goto input{width:70px;font-size:16px;padding:6px}
#settings label{display:block;margin:10px 0;font-size:15px}
#settings select{width:100%;font-size:15px;padding:8px;margin-top:4px}
.row{display:flex!important;gap:8px;align-items:center}
.small{font-size:13px;color:#555}
#toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);z-index:50;background:#111;color:#fff;padding:10px 14px;border-radius:12px;font-size:15px;max-width:92vw;text-align:center}
body.practice .ans{display:none}
.ans.ml{white-space:pre-line;align-items:center;line-height:1.15}
.ans.ctr{justify-content:center}
.ans.k-note,.ans.k-sent,.ans.k-comp{color:#2450c8}
.ans.k-mean{color:#0d7a5f}
.ans.k-month{color:#0d7a5f}
.inp input{font-size:calc(2.6cqw * var(--fs,1))}
